{
    "inputs": [
      {
        "id": "outline_api_key",
        "type": "promptString",
        "description": "Enter OUTLINE_API_KEY",
        "password": true
      },
      {
        "id": "outline_api_url",
        "type": "promptString",
        "description": "Outline API URL (optional, for self-hosted)",
        "password": false
      }
    ],
    "mcpServers": {
      "mcp-outline": {
        "command": "uvx",
        "args": ["mcp-outline"],
        "env": {
          "OUTLINE_API_KEY": "${env:OUTLINE_API_KEY}",
          "OUTLINE_API_URL": "${env:OUTLINE_API_URL}"
        }
      }
    }
  }